.DS_Store

# Heap dumps. `org.gradle.jvmargs` sets -XX:+HeapDumpOnOutOfMemoryError, so an OOM leaves one
# of these (hundreds of MB) in whatever directory the JVM was started from.
*.hprof

.intellijPlatform/
.kotlin/

# Cached scripts
scripts/cache/

# SDD scratch workspace
.superpowers/

# Third-party character art (Tiny RPG Character Asset Pack parts 1 & 2).
# Licensed art, NOT redistributable under this repo's terms - see docs/art-assets.md.
# Extract locally with scripts/extract-art.py; the manifest is committed, the pixels are not.
moba/src/main/resources/assets/sprites/
moba/raw-assets/

# `gamebridge.json` — the launch declaration `game-bridge-mcp` reads, written into the repository
# root by `:moba:udeaGenerateLaunchDeclaration` (which `assemble` and `run` both depend on).
#
# Generated, and **OS-specific**: `UdeaAgentPlugin` writes `.\gradlew.bat` on Windows and
# `./gradlew` everywhere else. Committing one machine's copy hands every other platform a launch
# command that cannot run, and `launch_instance` fails with a confusing "cannot start" rather than
# anything pointing at the cause. Run any Gradle build once and it appears.
gamebridge.json

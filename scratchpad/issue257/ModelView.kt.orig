package dev.wildware.udea.render.model

import dev.wildware.udea.render.draw.Rgba
import kotlin.math.PI
import kotlin.math.sqrt
import kotlin.math.tan

/**
 * How a [ModelCamera] flattens the world onto the picture (issue #257).
 *
 * The one thing that separates them: under [Perspective] a thing's size on screen depends on how far
 * away it is, and under [Orthographic] it does not. An isometric strategy game wants the second, so
 * that a tank at the top of the screen is exactly the size of the same tank at the bottom and the
 * edges of a building stay parallel however far across the map it stands.
 */
public enum class ModelProjection {

    /** A cone from the eye: the further away, the smaller. [ModelCamera.fovYDegrees] is its width. */
    Perspective,

    /** A box: no vanishing point, and [ModelCamera.viewHeight] is all the height there is. */
    Orthographic,
}

/**
 * Where the 3D world is seen from, and how it is flattened: in world units, Z up.
 *
 * Mutable and read by [ModelRenderSystem] every frame, so moving the camera is writing a field.
 * The 3D counterpart of `CameraRig`: handed to the system, not put on an entity.
 *
 * ## Which numbers are read
 *
 * [projection] decides. Under [ModelProjection.Perspective], the default and what every camera did
 * before issue #257, the picture is [fovYDegrees] tall in angle and [viewHeight] is not read. Under
 * [ModelProjection.Orthographic] the picture is [viewHeight] world units tall whatever the distance,
 * and [fovYDegrees] is not read. Both are kept because a camera changes projection at runtime - an
 * editor, a cutscene, a game with a tactical view - and losing the other one's framing on the way
 * through would be a surprise.
 *
 * ## Reading the camera back as plain numbers
 *
 * [writeViewMatrix] and [writeProjectionMatrix] hand out what the camera does to a world point, as
 * sixteen floats each, column-major, in OpenGL's convention: clip space is -1 to 1 across, up and in
 * depth. No Kool type is involved, so a game can un-project a click into the world (issue #262)
 * without naming one. They write into an array the caller owns, so reading the camera every frame
 * allocates nothing.
 */
public class ModelCamera(
    public var eyeX: Float = 0f,
    public var eyeY: Float = -10f,
    public var eyeZ: Float = 5f,
    public var targetX: Float = 0f,
    public var targetY: Float = 0f,
    public var targetZ: Float = 0f,
    /** Vertical field of view, in degrees. Read under [ModelProjection.Perspective]. */
    public var fovYDegrees: Float = 45f,
    /** Nearest distance drawn, in world units. */
    public var near: Float = 0.1f,
    /** Farthest distance drawn, in world units. */
    public var far: Float = 100f,
    /** How the world is flattened onto the picture. */
    public var projection: ModelProjection = ModelProjection.Perspective,
    viewHeight: Float = DEFAULT_VIEW_HEIGHT,
) {

    /**
     * How much of the world the picture is tall, in world units, whatever the distance. Read under
     * [ModelProjection.Orthographic]; the width follows from the picture's shape.
     */
    public var viewHeight: Float = viewHeight
        set(value) {
            require(value > 0f && value.isFinite()) {
                "a view height is a positive number of world units, was $value"
            }
            field = value
        }

    init {
        // Runs the setter's check on the constructor's value too.
        this.viewHeight = viewHeight
    }

    /** Puts the eye at `(x, y, z)`, looking at `(targetX, targetY, targetZ)`. */
    public fun lookAt(x: Float, y: Float, z: Float, targetX: Float, targetY: Float, targetZ: Float) {
        eyeX = x
        eyeY = y
        eyeZ = z
        this.targetX = targetX
        this.targetY = targetY
        this.targetZ = targetZ
    }

    /**
     * Writes the world-to-eye matrix into [out] - sixteen floats, column-major - and hands [out] back.
     *
     * Eye space is OpenGL's: the eye at the origin, looking down -Z, +X to the right of the picture
     * and +Y up it. Up in the world is +Z, as `Transform3D` has it. A camera looking straight down or
     * straight up has no roll to take from +Z, and takes +Y as up on the picture instead.
     */
    public fun writeViewMatrix(out: FloatArray): FloatArray {
        require(out.size == MATRIX_FLOATS) { "a 4x4 matrix is $MATRIX_FLOATS floats, this array is ${out.size}" }
        var fx = targetX - eyeX
        var fy = targetY - eyeY
        var fz = targetZ - eyeZ
        val length = sqrt(fx * fx + fy * fy + fz * fz)
        if (length > 0f) {
            fx /= length
            fy /= length
            fz /= length
        } else {
            // Told to look at where it already is: face +Y rather than hand out a matrix of NaN.
            fx = 0f
            fy = 1f
            fz = 0f
        }

        // Right on the picture is forward x (0, 0, 1). Straight up or down leaves that zero.
        var sx = fy
        var sy = -fx
        val across = sqrt(sx * sx + sy * sy)
        if (across > 0f) {
            sx /= across
            sy /= across
        } else {
            sx = 1f
            sy = 0f
        }

        // Up on the picture is right x forward, and right has no z, which is what shortens this.
        val ux = sy * fz
        val uy = -sx * fz
        val uz = sx * fy - sy * fx

        out[0] = sx
        out[1] = ux
        out[2] = -fx
        out[3] = 0f
        out[4] = sy
        out[5] = uy
        out[6] = -fy
        out[7] = 0f
        out[8] = 0f
        out[9] = uz
        out[10] = -fz
        out[11] = 0f
        out[12] = -(sx * eyeX + sy * eyeY)
        out[13] = -(ux * eyeX + uy * eyeY + uz * eyeZ)
        out[14] = fx * eyeX + fy * eyeY + fz * eyeZ
        out[15] = 1f
        return out
    }

    /**
     * Writes the eye-to-clip matrix into [out] - sixteen floats, column-major - and hands [out] back,
     * for a picture [aspect] wide per unit tall.
     *
     * [projection] chooses which matrix: a perspective frustum of [fovYDegrees], or a box
     * [viewHeight] world units tall. Depth runs -1 at [near] to 1 at [far], OpenGL's range.
     */
    public fun writeProjectionMatrix(out: FloatArray, aspect: Float): FloatArray {
        require(out.size == MATRIX_FLOATS) { "a 4x4 matrix is $MATRIX_FLOATS floats, this array is ${out.size}" }
        require(aspect > 0f && aspect.isFinite()) { "an aspect ratio is a positive number, was $aspect" }
        require(far > near) { "the far plane must be beyond the near one, they are $near and $far" }
        out.fill(0f)
        when (projection) {
            ModelProjection.Perspective -> {
                val half = tan(radians(fovYDegrees) / 2f)
                require(half > 0f) { "a field of view is a positive number of degrees under 180, was $fovYDegrees" }
                out[0] = 1f / (aspect * half)
                out[5] = 1f / half
                out[10] = (far + near) / (near - far)
                out[11] = -1f
                out[14] = 2f * far * near / (near - far)
            }
            ModelProjection.Orthographic -> {
                val halfHeight = viewHeight / 2f
                out[0] = 1f / (halfHeight * aspect)
                out[5] = 1f / halfHeight
                out[10] = -2f / (far - near)
                out[14] = -(far + near) / (far - near)
                out[15] = 1f
            }
        }
        return out
    }

    override fun toString(): String {
        val lens = when (projection) {
            ModelProjection.Perspective -> "Perspective(fov=$fovYDegrees)"
            ModelProjection.Orthographic -> "Orthographic(height=$viewHeight)"
        }
        return "ModelCamera(($eyeX, $eyeY, $eyeZ) -> ($targetX, $targetY, $targetZ), $lens)"
    }

    private companion object {
        const val MATRIX_FLOATS = 16

        /** Twenty world units tall: a few buildings across, the scale an isometric game starts at. */
        const val DEFAULT_VIEW_HEIGHT = 20f

        const val HALF_TURN_DEGREES = 180.0

        fun radians(degrees: Float): Float = (degrees * PI / HALF_TURN_DEGREES).toFloat()
    }
}

/**
 * How the 3D world is lit: one directional light that casts shadows, and a uniform ambient light.
 *
 * Mutable and read by [ModelRenderSystem] every frame.
 */
public class ModelLight(
    /** The direction the light travels, like sunlight: `(0, 0, -1)` shines straight down. */
    public var directionX: Float = -0.5f,
    public var directionY: Float = 0.6f,
    public var directionZ: Float = -1f,
    /** The light's colour. */
    public var color: Rgba = Rgba.WHITE,
    /** Multiplies [color]: how strong the light is. */
    public var intensity: Float = 3f,
    /**
     * Light that reaches every surface from everywhere, so a face turned away from the directional
     * light is dim rather than black.
     */
    public var ambient: Rgba = Rgba.of(0.25f, 0.25f, 0.3f),
    /**
     * How far from the camera, in world units, shadows are drawn. Nearer is sharper: the shadow
     * map's texels are spread over less of the world.
     */
    public var shadowDistance: Float = 25f,
) {

    init {
        require(shadowDistance > 0f) { "shadowDistance must be positive, was $shadowDistance" }
    }

    override fun toString(): String =
        "ModelLight(dir=($directionX, $directionY, $directionZ), $color x $intensity, ambient=$ambient)"
}
